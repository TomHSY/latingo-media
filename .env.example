# LatinGo Media Engine — environment variables
# Copy to .env and fill in values. Never commit .env.

# LatinGo API (read-only service account)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Instagram Graph API (Instagram API with Instagram Login)
META_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# Cloudflare R2 — public HTTPS URLs required for Meta to fetch images
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# OpenAI — carousel captions (gpt-4o-mini)
OPENAI_API_KEY=

# Set to true to render + upload without posting to Instagram
DRY_RUN=true

# Optional — force a scheduled job locally or via workflow_dispatch
# FORCE_PUBLISH=carousel
# FORCE_PUBLISH=stories

# Optional — Facebook Page (deferred for Instagram-only v1)
# FB_PAGE_ACCESS_TOKEN=
# FB_PAGE_ID=

# Optional — Google Drive (render:week --upload only)
# GOOGLE_DRIVE_FOLDER_ID=
